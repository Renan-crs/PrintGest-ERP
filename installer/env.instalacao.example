# Configuracao da instalacao do PrintGest ERP
#
# O scripts/empacotar.ps1 gera o .env da instalacao a partir DESTE arquivo -
# ele NAO le mais o backend/.env de desenvolvimento (que carrega segredos do
# ambiente de dev). O default abaixo nao embute nenhuma credencial secreta.
#
# Precisa de chaves que nao podem ficar no repositorio (ex.: api_key do
# Contrato C)? Copie este arquivo para `installer/env.instalacao` - esse nome
# e ignorado pelo git - e preencha la; o build usa a copia local quando existe.

# Banco local: o PostgreSQL EMBARCADO da propria instalacao (127.0.0.1).
# Nao aponte para um servidor externo sem desligar o PRINTGEST_PG_EMBARCADO.
PRINTGEST_DATABASE_URL=postgresql+psycopg://printgest:printgest@127.0.0.1:5432/printgest

# RedGest - servidor de licencas.
PRINTGEST_REDGEST_URL=https://redgest-system.onrender.com
PRINTGEST_REDGEST_SISTEMA=printgest

# Contrato do RedGest conforme o que foi emitido para o cliente:
#   b = CNPJ + codigo da licenca (handshake /api/v1/licencas/ - NAO usa api_key)
#   c = chave de produto (validacao HMAC /licencas-software/ - EXIGE api_key)
PRINTGEST_REDGEST_CONTRATO=b

# api_key do Sistema `printgest` no RedGest - SOMENTE para o Contrato C.
# Padrao VAZIO: o pacote nao carrega credencial nenhuma. Para um pacote
# Contrato C, preencha em `installer/env.instalacao` (fora do git) - o build
# RECUSA contrato=c com a chave vazia.
PRINTGEST_REDGEST_API_KEY=

# Cofre do SO para segredos locais (chave de ativacao, credenciais M2M):
# dpapi = Windows, escopo de maquina; nenhum = texto puro (so dev/diagnostico).
PRINTGEST_COFRE=dpapi

# Gate de serial: a tela de ativacao e obrigatoria antes do login.
# NAO ligue em pacotes de cliente - e o bypass de desenvolvimento.
PRINTGEST_LICENCA_DESABILITADA=false

# --------------------------------------------------------------- fixadas pelo
# build (nao precisam estar aqui; o empacotar.ps1 sempre impoe):
#   PRINTGEST_PG_EMBARCADO=true   - o daemon prepara o cluster na 1a execucao
#   PRINTGEST_API_HOST=127.0.0.1  - sem prompt de firewall, sem exposicao
#   PRINTGEST_ENV=local           - passa na checagem anti-defaults (P17)
