# PrintGest — variáveis de ambiente do Local API Service (backend).
# Copie para `backend/.env` e ajuste. Todas têm prefixo PRINTGEST_.
# Em produção defina ao menos PRINTGEST_ENV, PRINTGEST_DATABASE_URL e
# PRINTGEST_ADMIN_INICIAL_SENHA (ver app/core/config.py :: validar_producao).

# Ambiente: dev | local | test | producao (qualquer outro valor ativa o guard de produção)
PRINTGEST_ENV=dev

# Banco de dados (PostgreSQL)
PRINTGEST_DATABASE_URL=postgresql+psycopg://printgest:printgest@127.0.0.1:5432/printgest

# Rede
PRINTGEST_API_HOST=0.0.0.0
PRINTGEST_API_PORT=8000
# CORS (JSON list). Vazio = sem navegador/cross-origin.
PRINTGEST_CORS_ORIGINS=[]

# Migra o banco automaticamente no startup (alembic upgrade head, idempotente).
# false desliga — útil quando as migrations são aplicadas por pipeline próprio.
PRINTGEST_AUTO_MIGRATE=true

# Sessão / bloqueio por tentativas
PRINTGEST_SESSION_TTL_MINUTES=60
PRINTGEST_LOGIN_MAX_FALHAS=5
PRINTGEST_BLOQUEIO_MINUTOS=30

# Admin de fábrica (primeiro start). TROQUE em produção.
PRINTGEST_ADMIN_INICIAL_LOGIN=admin
PRINTGEST_ADMIN_INICIAL_SENHA=admin123
PRINTGEST_ADMIN_INICIAL_NOME=Administrador

# Licenciamento por chave de produto (RedGest Contrato C — `/licencas-software/`).
# O usuário digita a chave XXXX-XXXX-XXXX-XXXX na 1ª execução e o Local API
# Service a valida online, autenticando por HMAC-SHA256 do `Sistema.api_key`.
PRINTGEST_REDGEST_URL=http://127.0.0.1:9100
PRINTGEST_REDGEST_SISTEMA=printgest
# Segredo HMAC do Sistema `printgest` no RedGest. Sem ele a ativação falha com
# 502 antes de qualquer chamada de rede. TROQUE em produção.
PRINTGEST_REDGEST_API_KEY=
# De quanto em quanto tempo o loop acorda para checar a licença (segundos).
PRINTGEST_LICENCA_REFRESH_INTERVALO_SEGUNDOS=300
# De quanto em quanto tempo o RedGest é consultado de fato (default 6 h): detecta
# revogação/bloqueio/expiração. A licença em si vale até `expira_em`.
PRINTGEST_LICENCA_REVALIDAR_A_CADA_SEGUNDOS=21600
# Timeout da chamada ao RedGest (um Render frio responde em 30–60 s).
PRINTGEST_LICENCA_TIMEOUT_SEGUNDOS=90
# Tolerância offline após a vigência (`expira_em`) vencer (operação normal, com aviso).
PRINTGEST_LICENCA_TOLERANCIA_HORAS=72
# Backoff (segundos, CSV) entre tentativas de revalidação após falhas: 1/5/15 min.
PRINTGEST_LICENCA_BACKOFF_SEGUNDOS=60,300,900
# true = desliga o bloqueio por licença (somente dev/homologação)
PRINTGEST_LICENCA_DESABILITADA=false
